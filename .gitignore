# Node
node_modules/
frontend/dist/
frontend/build/
dist/
build/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env / secrets — NEVER commit real secrets
.env
.env.local
*.pem
*.key

# Databases (local dev artifacts)
*.db
*.db-journal
*.db-wal
*.db-shm

# Storage — uploaded runtime artifacts stay local (demo seed data in data/demo IS tracked)
storage/documents/*
storage/images/*
storage/sensor_data/*
storage/reports/*
storage/temporary/*
!storage/documents/.gitkeep
!storage/images/.gitkeep
!storage/sensor_data/.gitkeep
!storage/reports/.gitkeep
!storage/temporary/.gitkeep

# Logs
logs/
*.log

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Docker
.docker/

# Ollama / models (large weights never committed)
models/
*.gguf
*.bin
