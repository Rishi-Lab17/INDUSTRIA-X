# ============================================================
# INDUSTRIA-X — environment template (copy to .env, never commit .env)
# ============================================================

# --- Backend ---
APP_NAME=INDUSTRIA-X
APP_ENV=local
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./database/industria-x.db
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_VERIFY_MAX_PER_WINDOW=10
OTP_VERIFY_WINDOW_S=600
OTP_RESEND_COOLDOWN_S=60
OTP_RESEND_MAX_PER_HOUR=5
# Bcrypt cost (12 prod, 4 for fast tests)
BCRYPT_ROUNDS=12

# --- Email OTP delivery (Resend API, required for registration) ---
# Get a key at https://resend.com/api-keys and verify a sender domain.
# The key is used ONLY by the FastAPI backend — never the frontend.
# RESEND_ENABLED=true + key → Resend. No key + APP_ENV=local → local
# development outbox file (storage/temporary/dev-outbox/). No key in any
# other env → HTTP 502 (never a fake OTP).
# Place your own credential later directly in the local .env (never commit it).
RESEND_ENABLED=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=INDUSTRIA-X
# RESEND_BASE_URL=https://api.resend.com  (override for tests/proxy only)

# --- Firebase phone auth (verification only; authZ stays in INDUSTRIA-X) ---
# Needs a Firebase project with Phone sign-in enabled + service-account JSON.
# If unset, POST /api/auth/phone/link returns HTTP 501 (never faked).
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=./configs/firebase-service-account.json

# --- Storage (all local / on-premise) ---
STORAGE_DOCUMENTS=./storage/documents
STORAGE_IMAGES=./storage/images
STORAGE_SENSORS=./storage/sensor_data
STORAGE_REPORTS=./storage/reports
STORAGE_TEMP=./storage/temporary
MAX_UPLOAD_SIZE_MB=50

# --- Stage 3 knowledge base (all local; no external OCR/API) ---
# OCR needs a local engine (e.g. Tesseract binary on PATH). If missing, the
# pipeline degrades honestly: images stored, ocr_used=false, clear note.
OCR_ENABLED=true
OCR_PROVIDER=tesseract

# --- AI: Kimi K3 is the PRIMARY engine (OpenAI-compatible endpoint) ---
# Full Kimi K3 (~2.8T params, ~594GB-1.4TB) needs datacenter GPUs and
# CANNOT run on this laptop (RTX 3050 4GB). Point this at your on-prem
# vLLM/SGLang/llama.cpp server that serves the Kimi K3 weights.
AI_PROVIDER=kimi-k3
AI_ACTIVE_MODEL=kimi-k3
# URL of YOUR on-prem Kimi K3 inference server (OpenAI-compatible /v1 API).
# Default port 11436 is intentionally unused so health checks never probe the
# backend itself. Until a real server is set, Kimi honestly reports OFFLINE.
KIMI_K3_BASE_URL=http://127.0.0.1:11436/v1
KIMI_K3_MODEL=kimi-k3
KIMI_K3_API_KEY=local
KIMI_K3_TIMEOUT_S=120

# --- Dev-only local model (explicitly NOT Kimi K3) ---
# Used only so pipelines can be tested honestly while Kimi K3 is absent.
# The UI must always label which model actually answered.
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEV_MODEL=hf.co/nvidia/NVIDIA-Nemotron-3-Nano-4B-GGUF:Q4_K_M

# --- Embeddings / Vector DB (local) ---
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_PATH=./database/vectors.db

# --- Sovereignty (claims must reflect reality) ---
SOV_AI_INFERENCE=LOCAL
SOV_DOC_PROCESSING=LOCAL
SOV_KNOWLEDGE_BASE=LOCAL
SOV_VECTOR_DB=LOCAL
SOV_INDUSTRIAL_DATA=LOCAL
EXTERNAL_AI=BLOCKED
EXTERNAL_FALLBACK=DISABLED

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_URL=http://127.0.0.1:8000
# Firebase Web config for the phone-link page (optional; page shows
# "not configured" when absent):
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
