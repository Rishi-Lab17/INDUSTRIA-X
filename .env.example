# ============================================================
# INDUSTRIA-X — environment template (copy to .env, never commit .env)
# ============================================================

# --- Backend ---
APP_NAME=INDUSTRIA-X
APP_ENV=local
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./database/industria-x.db
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
OTP_EXPIRE_MINUTES=10
# Bcrypt cost (12 prod, 4 for fast tests)
BCRYPT_ROUNDS=12

# --- Storage (all local / on-premise) ---
STORAGE_DOCUMENTS=./storage/documents
STORAGE_IMAGES=./storage/images
STORAGE_SENSORS=./storage/sensor_data
STORAGE_REPORTS=./storage/reports
STORAGE_TEMP=./storage/temporary
MAX_UPLOAD_MB=50

# --- AI: Kimi K3 is the PRIMARY engine (OpenAI-compatible endpoint) ---
# Full Kimi K3 (~2.8T params, ~594GB-1.4TB) needs datacenter GPUs and
# CANNOT run on this laptop (RTX 3050 4GB). Point this at your on-prem
# vLLM/SGLang/llama.cpp server that serves the Kimi K3 weights.
AI_PROVIDER=kimi-k3
AI_ACTIVE_MODEL=kimi-k3
KIMI_K3_BASE_URL=http://127.0.0.1:8000/v1
KIMI_K3_MODEL=kimi-k3
KIMI_K3_API_KEY=local
KIMI_K3_TIMEOUT_S=120

# --- Dev-only local model (explicitly NOT Kimi K3) ---
# Used only so pipelines can be tested honestly while Kimi K3 is absent.
# The UI must always label which model actually answered.
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEV_MODEL=hf.co/nvidia/NVIDIA-Nemotron-3-Nano-4B-GGUF:Q4_K_M

# --- Embeddings / Vector DB (local) ---
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_PATH=./database/vectors.db

# --- Sovereignty (claims must reflect reality) ---
SOV_AI_INFERENCE=LOCAL
SOV_DOC_PROCESSING=LOCAL
SOV_KNOWLEDGE_BASE=LOCAL
SOV_VECTOR_DB=LOCAL
SOV_INDUSTRIAL_DATA=LOCAL
EXTERNAL_AI=BLOCKED
EXTERNAL_FALLBACK=DISABLED

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_URL=http://127.0.0.1:8000
